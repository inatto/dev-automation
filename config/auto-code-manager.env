# Intervalo entre os ciclos principais, em segundos.
INTERVAL=2

# Intervalo entre limpezas de arquivos Zone.Identifier, em segundos.
ZONE_EVERY=4

# Intervalo entre backups dos projetos, em segundos.
BACKUP_EVERY=15

# Tempo para confirmar que um ZIP terminou de ser gravado, em segundos.
STABLE_WAIT=5

# Quantidade de avisos sonoros após uma importação concluída.
BEEP_REPEATS=1

# Pausa entre os avisos sonoros, em milissegundos.
BEEP_GAP_MS=180

# Tipo de aviso: wave usa o som suave; beep força o beep eletrônico.
BEEP_MODE="wave"

# Volume do WAV no Windows, de 0 a 100. Valor baixo recomendado: 15 a 30.
BEEP_VOLUME=22

# Arquivo WAV usado no aviso. Caminho absoluto calculado a partir da pasta do próprio script.
BEEP_WAVE_FILE="$PROJECT_ROOT/assets/sounds/soft-notification.wav"

# WAV nativo do Windows tentado primeiro. Este arquivo existe em instalações padrão.
BEEP_WINDOWS_WAVE_FILE="C:\\Windows\\Media\\notify.wav"

# Toca um único aviso curto e discreto somente depois que toda a rodada de
# backup termina com sucesso, incluindo a criação e validação do Code.zip.
BACKUP_BEEP_ENABLED=true

# Som nativo do Windows tocado uma vez após a rodada completa de backup.
# O volume é controlado pelo volume geral do Windows.
BACKUP_WINDOWS_WAVE_FILE="C:\\Windows\\Media\\ding.wav"

# Volume e WAV usados apenas como fallback quando o Windows/ding.wav não puder
# ser acessado pelo WSL.
BACKUP_BEEP_VOLUME=18
BACKUP_BEEP_WAVE_FILE="$PROJECT_ROOT/assets/sounds/backup-complete.wav"

# Exibe o estado do Auto Code Manager na taskbar do Windows quando
# apps/dev-status/bin/dev-status.exe estiver compilado.
TASKBAR_STATUS_ENABLED=true
