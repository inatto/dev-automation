#!/usr/bin/env bash
set -euo pipefail

LRDP_NAME="lrdp2"
LRDP_LABEL="RDP 2"
LRDP_TARGET="192.168.1.47"
LRDP_PORT=3389
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Cadastre outros logins copiando uma linha abaixo no formato:
#   "Nome exibido|usuario|senha"
LOGIN_PROFILES=(
    "Principal|daniel|20bqns_DL.."
    "Gov|govbr|20bqns_GR"
)

# shellcheck source=apps/lrdp/lrdp-common.sh
source "$SCRIPT_DIR/lrdp-common.sh"

if [[ "${1:-}" == "--metadata" ]]; then
  print_lrdp_metadata
  exit 0
fi
if [[ "${1:-}" == "--saved" ]]; then
  LRDP_USE_SAVED=1
  shift
fi

configure_lrdp

rdp_args=(
  "/v:$LRDP_TARGET"
  "/u:$rdp_user"
  /multimon
  "/audio-mode:$selected_audio_mode"
  /cert:ignore
)

monitor_order="$(build_monitor_order "$selected_primary_monitor")"
if [[ -n "$monitor_order" ]]; then
  rdp_args+=("/monitors:$monitor_order")
fi
if [[ "$selected_microphone" == yes ]]; then
  rdp_args+=(/microphone)
fi
if [[ -n "$rdp_password" ]]; then
  rdp_args+=("/p:$rdp_password")
fi

exec xfreerdp3 "${rdp_args[@]}" "$@"
