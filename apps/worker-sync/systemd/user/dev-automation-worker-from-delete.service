[Unit]
Description=Dev Automation Worker FROM - sobe backup com o mesmo nome e limpa a fila remota
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@PROJECT_ROOT@/apps/worker-sync/scripts/delete-from-watch.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
