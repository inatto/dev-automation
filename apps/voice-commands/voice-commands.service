[Unit]
Description=Voice Commands - comandos locais por microfone
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Code/bots/dev-automation/apps/voice-commands
ExecStart=/usr/bin/bash %h/Code/bots/dev-automation/apps/voice-commands/run.sh --no-tui
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
